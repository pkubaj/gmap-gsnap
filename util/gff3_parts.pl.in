#! @PERL@

use warnings;

my $package_version = "@PACKAGE_VERSION@";

use Getopt::Long;
Getopt::Long::Configure(qw(no_auto_abbrev no_ignore_case_always));

GetOptions(
    'T|exclude-nontranscribed' => \$exclude_nontranscribed_p,
    'I|exclude-immune' => \$exclude_immune_p,
    'L|exclude-lincrna' => \$exclude_lincrna_p,
    'R|exclude-readthrough' => \$exclude_readthrough_p,
    'P|exclude-PAR' => \$exclude_PAR_p,
    );

# Protein coding or processed transcript
if (!defined($exclude_nontranscribed_p)) {
    $exclude_nontranscribed_p = 0;
}

if (!defined($exclude_immune_p)) {
    $exclude_immune_p = 0;
}

if (!defined($exclude_lincrna_p)) {
    $exclude_lincrna_p = 0;
}

if (!defined($exclude_readthrough_p)) {
    $exclude_readthrough_p = 0;
}

if (!defined($exclude_PAR_p)) {
    $exclude_PAR_p = 0;
}


$line = <>;
while (defined($gene = read_gene())) {
#    if (gene_valid_p($gene->{type}) == 1) {
	print_parts($gene);
#    }
}

exit;


sub print_transcript_no_cds {
    my ($transcript_id, $transcript, $gene_id, $gene) = @_;
    my $nexons = $#{$transcript->{exons}} + 1;
    my $nintrons = $nexons - 1;

    # print "Entered print_transcript_no_cds\n";

    # First exon
    my $exoni = 0;
    $curr_exon = $ {$transcript->{exons}}[0];
    printf ">$transcript_id;%s;exon%d/%d ",$transcript->{type},$exoni+1,$nexons;
    if ($transcript->{dir} eq "+") {
	printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$curr_exon->{high};
    } elsif ($transcript->{dir} eq "-") {
	printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$curr_exon->{low};
    } else {
	die "Unrecognized direction $transcript->{dir}";
    }

    print $gene_id . " ";
    print $gene->{name} . " ";
    print $gene->{type} . " ";
    print $gene->{description} . "\n";

		
    # Remaining exons
    for (my $exoni = 1; $exoni < $nexons; $exoni++) {
	$prev_exon = $ {$transcript->{exons}}[$exoni-1];
	$curr_exon = $ {$transcript->{exons}}[$exoni];

	# Print intron
	printf ">$transcript_id;%s;intron%d/%d ",$transcript->{type},$exoni,$nintrons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$prev_exon->{high} + 1,$curr_exon->{low} - 1;
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$prev_exon->{low} - 1,$curr_exon->{high} + 1;
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";
	
	# Print exon
	printf ">$transcript_id;%s;exon%d/%d ",$transcript->{type},$exoni+1,$nexons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$curr_exon->{high};
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$curr_exon->{low};
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";
    }

    return;
}

sub print_transcript_with_cds {
    my ($transcript_id, $transcript, $gene_id, $gene) = @_;
    my $nexons = $#{$transcript->{exons}} + 1;
    my $nintrons = $nexons - 1;

    my $ncds = $#{$transcript->{cds}} + 1;
    my $cds5 = $ {$transcript->{cds}}[0];
    my $cds3 = $ {$transcript->{cds}}[$ncds - 1];
    
    # print "Entered print_transcript_with_cds\n";
    # print "$ncds CDSs\n";

    # Find exons with cds5 and cds3
    if ($transcript->{dir} eq "+") {
	$exoni = 0;
	while ($exoni < $nexons && defined($exon = $ {$transcript->{exons}}[$exoni]) && $exon->{high} < $cds5->{low}) {
	    $exoni++;
	}
	$exoni5 = $exoni;

	$exoni = $nexons - 1;
	while ($exoni >= 0 && defined($exon = $ {$transcript->{exons}}[$exoni]) && $exon->{low} > $cds3->{high}) {
	    $exoni--;
	}
	$exoni3 = $exoni;
	# print "UTR exons: $exoni5 and $exoni3\n";

    } else {
	$exoni = 0;
	while ($exoni < $nexons && defined($exon = $ {$transcript->{exons}}[$exoni]) && $exon->{low} > $cds5->{high}) {
	    $exoni++;
	}
	$exoni5 = $exoni;

	$exoni = $nexons - 1;
	while ($exoni >= 0 && defined($exon = $ {$transcript->{exons}}[$exoni]) && $exon->{high} < $cds3->{low}) {
	    $exoni--;
	}
	$exoni3 = $exoni;
	# print "UTR exons: $exoni5 and $exoni3\n";
    }

    for ($exoni = 0; $exoni < $exoni5; $exoni++) {
	# Exons before the one with CDS bounds
	$curr_exon = $ {$transcript->{exons}}[$exoni];
	$next_exon = $ {$transcript->{exons}}[$exoni + 1];

	# Print exon
	printf ">$transcript_id;%s;exon%d/%d.utr5 ",$transcript->{type},$exoni+1,$nexons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$curr_exon->{high};
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$curr_exon->{low};
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}

	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";


	# Print following intron
	printf ">$transcript_id;%s;intron%d/%d ",$transcript->{type},$exoni+1,$nintrons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high} + 1,$next_exon->{low} - 1;
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low} - 1,$next_exon->{high} + 1;
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}

	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";
    }

    if ($exoni5 == $exoni3) {
	# Single exon with the CDS bounds
	$exoni = $exoni5;
	$curr_exon = $ {$transcript->{exons}}[$exoni];
	
	# 5' UTR part of single exon
	if ($transcript->{dir} eq "+") {
	    if ($curr_exon->{low} < $cds5->{low}) {
		# Part with 5' UTR
		printf ">$transcript_id;%s;exon%d/%d.utr5 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$cds5->{low} - 1;
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} elsif ($transcript->{dir} eq "-") {
	    if ($curr_exon->{high} > $cds5->{high}) {
		printf ">$transcript_id;%s;exon%d/%d.utr5 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$cds5->{high} + 1;
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}


	# Coding part of single exon
	printf ">$transcript_id;%s;exon%d/%d.cds ",$transcript->{type},$exoni+1,$nexons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$cds5->{low},$cds3->{high};
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$cds5->{high},$cds3->{low};
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}

	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";

	# 3' UTR part of single exon
	if ($transcript->{dir} eq "+") {
	    if ($curr_exon->{high} > $cds3->{high}) {
		printf ">$transcript_id;%s;exon%d/%d.utr3 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$cds3->{high} + 1,$curr_exon->{high};
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} elsif ($transcript->{dir} eq "-") {
	    if ($curr_exon->{low} < $cds3->{low}) {
		printf ">$transcript_id;%s;exon%d/%d.utr3 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$cds3->{low} - 1,$curr_exon->{low};
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}


    } else {
	$exoni = $exoni5;
	$curr_exon = $ {$transcript->{exons}}[$exoni];
	$next_exon = $ {$transcript->{exons}}[$exoni + 1];

	# 5' UTR part of 5' CDS exon
	if ($transcript->{dir} eq "+") {
	    if ($curr_exon->{low} < $cds5->{low}) {
		printf ">$transcript_id;%s;exon%d/%d.utr5 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$cds5->{low} - 1;
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} elsif ($transcript->{dir} eq "-") {
	    if ($curr_exon->{high} > $cds5->{high}) {
		printf ">$transcript_id;%s;exon%d/%d.utr5 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$cds5->{high} + 1;
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}


	# Coding part of 5' CDS exon
	printf ">$transcript_id;%s;exon%d/%d.cds ",$transcript->{type},$exoni+1,$nexons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$cds5->{low},$curr_exon->{high};
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$cds5->{high},$curr_exon->{low};
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";

	# Intron after utr5
	printf ">$transcript_id;%s;intron%d/%d ",$transcript->{type},$exoni+1,$nintrons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high} + 1,$next_exon->{low} - 1;
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low} - 1,$next_exon->{high} + 1;
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";


	# Middle CDS exons
	for ($exoni = $exoni5 + 1; $exoni < $exoni3; $exoni++) {
	    $curr_exon = $ {$transcript->{exons}}[$exoni];
	    $next_exon = $ {$transcript->{exons}}[$exoni + 1];

	    # Print exon
	    printf ">$transcript_id;%s;exon%d/%d.cds ",$transcript->{type},$exoni+1,$nexons;
	    if ($transcript->{dir} eq "+") {
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$curr_exon->{high};
	    } elsif ($transcript->{dir} eq "-") {
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$curr_exon->{low};
	    } else {
		die "Unrecognized direction $transcript->{dir}";
	    }
	    
	    print $gene_id . " ";
	    print $gene->{name} . " ";
	    print $gene->{type} . " ";
	    print $gene->{description} . "\n";


	    # Print following intron
	    printf ">$transcript_id;%s;intron%d/%d ",$transcript->{type},$exoni+1,$nintrons;
	    if ($transcript->{dir} eq "+") {
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high} + 1,$next_exon->{low} - 1;
	    } elsif ($transcript->{dir} eq "-") {
		printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low} - 1,$next_exon->{high} + 1;
	    } else {
		die "Unrecognized direction $transcript->{dir}";
	    }

	    print $gene_id . " ";
	    print $gene->{name} . " ";
	    print $gene->{type} . " ";
	    print $gene->{description} . "\n";
	}


	# Coding part of 3' CDS exon
	$exoni = $exoni3;
	$curr_exon = $ {$transcript->{exons}}[$exoni];

	printf ">$transcript_id;%s;exon%d/%d.cds ",$transcript->{type},$exoni+1,$nexons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$cds3->{high};
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$cds3->{low};
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";
	
	# 3' UTR part of 3' CDS exon
	if ($transcript->{dir} eq "+") {
	    if ($curr_exon->{high} > $cds3->{high}) {
		printf ">$transcript_id;%s;exon%d/%d.utr3 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$cds3->{high} + 1,$curr_exon->{high};
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} elsif ($transcript->{dir} eq "-") {
	    if ($curr_exon->{low} < $cds3->{low}) {
		printf ">$transcript_id;%s;exon%d/%d.utr3 ",$transcript->{type},$exoni+1,$nexons;
		printf "%s:%u..%u\n",$transcript->{chr},$cds3->{low} - 1,$curr_exon->{low};
		print $gene_id . " ";
		print $gene->{name} . " ";
		print $gene->{type} . " ";
		print $gene->{description} . "\n";
	    }
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
    }

    # Exons after the one with CDS bounds
    for ($exoni = $exoni3 + 1; $exoni < $nexons; $exoni++) {
	$prev_exon = $ {$transcript->{exons}}[$exoni-1];
	$curr_exon = $ {$transcript->{exons}}[$exoni];
	
	# Print preceding intron
	printf ">$transcript_id;%s;intron%d/%d ",$transcript->{type},$exoni,$nintrons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$prev_exon->{high} + 1,$curr_exon->{low} - 1;
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$prev_exon->{low} - 1,$curr_exon->{high} + 1;
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";
	
	# Print exon
	printf ">$transcript_id;%s;exon%d/%d.utr3 ",$transcript->{type},$exoni+1,$nexons;
	if ($transcript->{dir} eq "+") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{low},$curr_exon->{high};
	} elsif ($transcript->{dir} eq "-") {
	    printf "%s:%u..%u\n",$transcript->{chr},$curr_exon->{high},$curr_exon->{low};
	} else {
	    die "Unrecognized direction $transcript->{dir}";
	}
	
	print $gene_id . " ";
	print $gene->{name} . " ";
	print $gene->{type} . " ";
	print $gene->{description} . "\n";
    }

    return;
}


sub print_parts {
    my ($gene) = @_;

    foreach my $transcript (@ {$gene->{transcripts}}) {
#	if (transcript_valid_p($transcript->{type}) == 1) {
	    my $transcript_id = $transcript->{id};
	    $transcript_id =~ s/^rna-//;
	    
	    my $gene_id = $gene->{id};
	    $gene_id =~ s/^gene-//;
	    
	    if ($#{$transcript->{cds}} >= 0) {
		print_transcript_with_cds($transcript_id,$transcript,$gene_id,$gene);
	    } else {
		print_transcript_no_cds($transcript_id,$transcript,$gene_id,$gene);
	    }

#	}
    }

    return;
}


sub gene_valid_p {
    my ($type) = @_;

    if ($type eq "gene") {
	return 1;
    } else {
	return 0;
    }
}


sub gene_line_p {
    my ($line) = @_;

    if ($line =~ /^\S+\t\S+\tgene\t/) {
	return 1;
    } else {
	return 0;
    }
}


# Works with GENCODE
sub gene_type {
    my ($line) = @_;

    if ($line =~ /gene_type=([^;]+)/) {
	return $1;
    } else {
	return "no_gene_type";
    }
}


sub read_gene {
    my @transcripts = ();
    my $type;

    while (defined($line) && gene_line_p($line) == 0) {
	$line = <>;
    }

    if (!defined($line)) {
	# print "End of file: Exiting read_gene";
	return;

    } else {
	# print "Gene: $line";

	chop $line;
	$type = gene_type($line);

	my @fields = split /\t/,$line;
	my ($gene_id) = $fields[8] =~ /ID=([^;]+)/;
	if (!defined($gene_id)) {
	    die "Cannot find ID in $fields[8]";
	}
	my ($gene_name) = $fields[8] =~ /Name=([^;]+)/; # NCBI
	if (!defined($gene_name)) {
	    ($gene_name) = $fields[8] =~ /gene_name=([^;]+)/; # Gencode
	}
	if (!defined($gene_name)) {
	    die "Cannot find Name or gene_namein $fields[8]";
	}
	my ($gene_description) = $fields[8] =~ /description=([^;]+)/; # NCBI
	if (!defined($gene_description)) {
	    $gene_description = "";
	}

	$line = <>;
	while (defined(my $transcript = read_transcript($gene_id))) {
	    push @transcripts,$transcript;
	}

	# print "Exiting read_gene with a gene";
	return new Gene($type,$gene_id,$gene_name,$gene_description,\@transcripts);
    }
}


sub transcript_valid_p {
    my ($type) = @_;

    if ($type eq "transcript") {
	return 1;
    } elsif ($type eq "primary_transcript") {
	return 1;
    } elsif ($type eq "mRNA") {
	return 1;
    } else {
	return 0;
    }
}


sub transcript_line_p {
    my ($line) = @_;

    if ($line =~ /^\S+\t\S+\ttranscript\t/) {
	return 1;
    } else {
	return 0;
    }
}


# Works with GENCODE
sub transcript_type {
    my ($line) = @_;

    if ($line =~ /transcript_type=([^;]+)/) {
	return $1;
    } else {
	return "no_transcript_type";
    }
}


sub exon_line_p {
    my ($line) = @_;

    if ($line =~ /^\S+\t\S+\texon\t/) {
	return 1;
    } else {
	return 0;
    }
}

sub CDS_line_p {
    my ($line) = @_;

    if ($line =~ /^\S+\t\S+\tCDS\t/) {
	return 1;
    } else {
	return 0;
    }
}


sub read_transcript {
    my ($gene_id) = @_;
    my $gene_type;

    # print "Entering read_transcript with $line";
    while (defined($line) && gene_line_p($line) == 0 && transcript_line_p($line) == 0) {
	$line = <>;
    }

    if (!defined($line)) {
	# print "End of file; exiting read_transcript\n";
	return;

    } elsif (gene_line_p($line) == 1) {
	# print "End of gene; exiting read_transcript with $line\n";
	return;

    } else {
	# print "Transcript: $line";
	$type = transcript_type($line);

	chop $line;
	my @fields = split /\t/,$line;
	my ($parent_id) = $fields[8] =~ /Parent=([^;]+)/;
	if (!defined($parent_id)) {
	    die "Cannot find Parent in $fields[8]";
	} elsif ($parent_id ne $gene_id) {
	    die "Transcript parent is not $gene_id in $line";
	}

	my ($transcript_id) = $fields[8] =~ /ID=([^;]+)/;
	if (!defined($transcript_id)) {
	    die "Cannot find ID in $fields[8]";
	}
	my $chr = $fields[0];
	my $dir = $fields[6];
	my $transcript_low = $fields[3];
	my $transcript_high = $fields[4];

	$line = <>;
	my @exons = ();
	my @cds = ();
	while (defined($line) && gene_line_p($line) == 0 && transcript_line_p($line) == 0) {
	    if (exon_line_p($line) == 1) {
		my @fields = split /\t/,$line;
		my ($parent_id) = $fields[8] =~ /Parent=([^;]+)/;
		if (!defined($parent_id)) {
		    die "Cannot find Parent in $fields[8]";
		} elsif ($parent_id ne $transcript_id) {
		    # Skip: Could be exon for an miRNA
		} else {
		    my $exon_low = $fields[3];
		    my $exon_high = $fields[4];
		    push @exons,new Exon($exon_low,$exon_high);
		}

	    } elsif (CDS_line_p($line) == 1) {
		my @fields = split /\t/,$line;
		my ($parent_id) = $fields[8] =~ /Parent=([^;]+)/;
		if (!defined($parent_id)) {
		    die "Cannot find Parent in $fields[8]";
		} elsif ($parent_id ne $transcript_id) {
		    # Skip: Could be exon for an miRNA
		} else {
		    my $cds_low = $fields[3];
		    my $cds_high = $fields[4];
		    push @cds,new CDS($cds_low,$cds_high);
		}
	    }

	    $line = <>;
	}

	# print "Exiting read_transcript with type $type, id $transcript_id\n";
	return new Transcript($type,$transcript_id,$chr,$dir,$transcript_low,$transcript_high,\@exons,\@cds);
    }
}


sub gene_class {
    my ($gene_type) = @_;

    if ($gene_type eq "IG_V_gene" || $gene_type eq "IG_D_gene" ||
	$gene_type eq "IG_J_gene" || $gene_type eq "IG_C_gene") {
	return "immune";

    } elsif ($gene_type eq "TR_V_gene" || $gene_type eq "TR_D_gene" ||
	     $gene_type eq "TR_J_gene" || $gene_type eq "TR_C_gene") {
	return "immune";

    } elsif ($gene_type eq "IG_V_gene" || $gene_type eq "IG_D_gene" ||
	     $gene_type eq "IG_J_gene" || $gene_type eq "IG_C_gene") {
	return "immune";

    } elsif ($gene_type eq "TR_V_gene" || $gene_type eq "TR_D_gene" ||
	     $gene_type eq "TR_J_gene" || $gene_type eq "TR_C_gene") {
	return "immune";

    } elsif ($gene_type eq "lincRNA") {
	return "lincrna";

    } elsif ($gene_type eq "protein_coding") {
	return "transcribed";

    } elsif ($gene_type eq "processed_transcript") {
	return "transcribed";

    } elsif ($gene_type eq "polymorphic_pseudogene") {
	return "transcribed";

    } elsif ($gene_type eq "pseudogene") {
	# Depends on the transcript
	return "transcribed";

    } else {
	return "other";
    }
}


# Note: processed pseudogenes lack introns
sub transcript_class {
    my ($transcript_type) = @_;

    if ($transcript_type eq "IG_V_gene" || $transcript_type eq "IG_D_gene" ||
	$transcript_type eq "IG_J_gene" || $transcript_type eq "IG_C_gene") {
	return "immune";

    } elsif ($transcript_type eq "TR_V_gene" || $transcript_type eq "TR_D_gene" ||
	     $transcript_type eq "TR_J_gene" || $transcript_type eq "TR_C_gene") {
	return "immune";

    } elsif ($transcript_type eq "IG_V_gene" || $transcript_type eq "IG_D_gene" ||
	     $transcript_type eq "IG_J_gene" || $transcript_type eq "IG_C_gene") {
	return "immune"

    } elsif ($transcript_type eq "TR_V_gene" || $transcript_type eq "TR_D_gene" ||
	     $transcript_type eq "TR_J_gene" || $transcript_type eq "TR_C_gene") {
	return "immune";

    } elsif ($transcript_type eq "lincRNA") {
	return "lincrna";

    } elsif ($transcript_type eq "protein_coding") {
	return "transcribed";

    } elsif ($transcript_type eq "processed_transcript") {
	return "transcribed";

    } elsif ($transcript_type eq "nonsense_mediated_decay") {
	return "transcribed";

    } elsif ($transcript_type eq "polymorphic_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "processed_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "transcribed_processed_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "transcribed_unprocessed_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "translated_unprocessed_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "unitary_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "unprocessed_pseudogene") {
	return "transcribed";

    } elsif ($transcript_type eq "sense_overlapping") {
	return "transcribed";

    } elsif ($transcript_type eq "retained_intron") {
	return "transcribed";

    } else {
	return "other";
    }
}


